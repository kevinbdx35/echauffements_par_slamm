---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  // Page à ne pas indexer (404) : pas de canonical, robots noindex
  noindex?: boolean;
}
const { title, description = 'Programme d\'échauffement NOGI et MMA par SLAMM', noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
const isActive = (segment: string) => pathname.includes(`/${segment}`);

const siteName = 'Échauffements par SLAMM';
const homeUrl = new URL(base, Astro.site).href;
const canonical = new URL(pathname, Astro.site).href;
const ogImage = new URL(`${base}og.png`, Astro.site).href;
const isHome = canonical === homeUrl;

// Données structurées : le site sur l'accueil, le fil d'Ariane sur les autres pages
const jsonLd = isHome
  ? { '@context': 'https://schema.org', '@type': 'WebSite', name: siteName, url: homeUrl, inLanguage: 'fr' }
  : {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: homeUrl },
        { '@type': 'ListItem', position: 2, name: title, item: canonical },
      ],
    };
---

<!doctype html>
<html lang="fr" class="bg-bg text-fg">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Échauffements MMA et NOGI par SLAMM" />
    <meta name="twitter:card" content="summary_large_image" />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="min-h-dvh flex flex-col font-sans antialiased">
    <header class="sticky top-0 z-10 border-b border-line bg-bg/90 backdrop-blur-md">
      <div class="max-w-site mx-auto px-4 md:px-8 h-14 flex items-center justify-between gap-4">
        <a href={base} class="h-full flex items-center gap-2 whitespace-nowrap">
          <span class="text-accent text-lg leading-none" aria-hidden="true">⬡</span>
          <span class="font-display text-xl tracking-[0.01em]"><span class="hidden sm:inline">Échauffements par </span>SLAMM</span>
        </a>
        <nav class="h-full flex" aria-label="Programmes">
          <a href={`${base}mma`} aria-current={isActive('mma') ? 'page' : undefined} class:list={["h-full flex items-center px-2.5 -mb-px border-b-2 text-sm font-semibold transition-colors duration-150", isActive('mma') ? "text-fg border-accent" : "text-muted border-transparent hover:text-fg"]}>MMA</a>
          <a href={`${base}nogi`} aria-current={isActive('nogi') ? 'page' : undefined} class:list={["h-full flex items-center px-2.5 -mb-px border-b-2 text-sm font-semibold transition-colors duration-150", isActive('nogi') ? "text-fg border-accent" : "text-muted border-transparent hover:text-fg"]}>NOGI</a>
          <a href={`${base}etirements`} aria-current={isActive('etirements') ? 'page' : undefined} class:list={["h-full flex items-center px-2.5 -mb-px border-b-2 text-sm font-semibold transition-colors duration-150", isActive('etirements') ? "text-fg border-accent" : "text-muted border-transparent hover:text-fg"]}>Étirements</a>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-line">
      <div class="max-w-site mx-auto px-4 md:px-8 py-6 flex flex-wrap justify-between gap-3 text-muted text-[13px]">
        <span>Site créé par Kevin depuis la Bretagne</span>
        <span>SLAMM</span>
      </div>
    </footer>
  </body>
</html>
