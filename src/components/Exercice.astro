---
import Icon from './Icon.astro';

type VideoEntry = string | { id: string; start?: number };

interface Props {
  numero: number;
  titre: string;
  description: string;
  youtubeIds: VideoEntry[];
  duree: string;
}
const { numero, titre, description, youtubeIds, duree } = Astro.props;
const videos = youtubeIds
  .map(v => typeof v === 'string' ? { id: v, start: undefined } : v)
  .filter(v => v.id.trim() !== '');

const principale = videos[0];
---

<article class="exercice grid gap-4 py-7 border-b border-line lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-8 lg:py-9" data-titre={titre}>
  <div class="min-w-0 grid grid-cols-[44px_minmax(0,1fr)] gap-x-3 content-start">
    <span class="font-display text-[32px] leading-[0.95] text-faint tabular-nums" aria-hidden="true">
      {String(numero).padStart(2, '0')}
    </span>
    <h3 class="col-start-2 font-display text-[clamp(26px,4.4vw,32px)] leading-[0.98]">{titre}</h3>
    {duree && (
      <p class="col-start-2 justify-self-start mt-3 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-surface-2 text-[13px] font-bold tabular-nums">
        <Icon name="timer" class="size-3.5 text-accent" />{duree}
      </p>
    )}
    {description && (
      <p class="col-span-2 md:col-span-1 md:col-start-2 mt-3 text-muted max-w-[60ch]">{description}</p>
    )}
  </div>

  {videos.length > 0 ? (
    <div class="min-w-0 flex flex-col gap-2.5">
      <div
        class="main-video relative aspect-video w-full rounded-xl overflow-hidden bg-surface-2"
        data-video-id={principale.id}
        data-video-start={principale.start ?? ''}
      >
        <button type="button" class="play-btn group absolute inset-0 w-full h-full" aria-label={`Lire la vidéo : ${titre}`}>
          <img
            src={`https://img.youtube.com/vi/${principale.id}/hqdefault.jpg`}
            alt=""
            class="w-full h-full object-cover transition-opacity duration-150 ease-out"
            loading="lazy"
          />
          <span class="play-icon absolute inset-0 m-auto size-16 rounded-full bg-black/60 backdrop-blur-sm grid place-items-center text-white transition-[background-color,transform] duration-150 ease-out group-hover:bg-accent-strong motion-safe:group-active:scale-95">
            <Icon name="play" class="size-[26px] ml-[3px]" />
          </span>
        </button>
        <div class="video-error hidden absolute inset-0 flex items-center justify-center bg-surface-2">
          <span class="text-muted text-sm font-semibold">Vidéo indisponible</span>
        </div>
      </div>
      {videos.length > 1 && (
        <div class="flex flex-col-reverse gap-2">
          <div class="flex gap-2 overflow-x-auto p-0.5">
            {videos.map((v, i) => (
              <button
                type="button"
                class:list={[
                  "comp-thumb press shrink-0 w-[88px] aspect-video rounded-md overflow-hidden bg-surface-2 ring-2",
                  i === 0 ? "opacity-100 ring-accent" : "opacity-50 ring-transparent hover:opacity-80"
                ]}
                data-video-id={v.id}
                data-video-start={v.start ?? ''}
                data-index={i}
                aria-label={i === 0 ? "Vidéo principale" : `Vidéo complémentaire ${i}`}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                <img src={`https://img.youtube.com/vi/${v.id}/mqdefault.jpg`} alt="" class="w-full h-full object-cover" loading="lazy" />
              </button>
            ))}
          </div>
          <p class="video-caption text-[13px] text-muted" aria-live="polite">Vidéo principale</p>
        </div>
      )}
    </div>
  ) : (
    <div class="rounded-xl border border-dashed border-line flex items-center justify-center py-6">
      <span class="text-muted text-sm">Vidéo à venir</span>
    </div>
  )}
</article>

<script>
  function showError(mainEl: HTMLElement) {
    mainEl.querySelector('.play-btn')?.classList.add('hidden');
    mainEl.querySelector('.video-error')?.classList.remove('hidden');
    mainEl.dataset.unavailable = 'true';
  }

  function watchThumbnail(mainEl: HTMLElement) {
    const img = mainEl.querySelector<HTMLImageElement>('.play-btn img');
    if (!img) return;
    img.addEventListener('error', () => showError(mainEl), { once: true });
    if (img.complete && img.naturalWidth === 0) showError(mainEl);
  }

  function setMainVideo(mainEl: HTMLElement, id: string, start: string) {
    mainEl.dataset.videoId = id;
    mainEl.dataset.videoStart = start;
    delete mainEl.dataset.unavailable;
    mainEl.querySelector('iframe')?.remove();
    mainEl.querySelector('.video-error')?.classList.add('hidden');

    const btn = mainEl.querySelector('.play-btn') as HTMLElement;
    btn.classList.remove('hidden');
    const img = btn.querySelector('img') as HTMLImageElement;
    img.classList.add('opacity-0');
    img.addEventListener('load', () => img.classList.remove('opacity-0'), { once: true });
    img.addEventListener('error', () => showError(mainEl), { once: true });
    img.src = `https://img.youtube.com/vi/${id}/hqdefault.jpg`;
  }

  function playMainVideo(mainEl: HTMLElement) {
    if (mainEl.dataset.unavailable || mainEl.querySelector('iframe')) return;
    const id = mainEl.dataset.videoId!;
    const start = mainEl.dataset.videoStart;
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1${start ? `&start=${start}` : ''}`;
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
    iframe.allowFullscreen = true;
    iframe.title = (mainEl.closest('.exercice') as HTMLElement)?.dataset.titre ?? '';
    iframe.className = 'absolute inset-0 w-full h-full';
    mainEl.querySelector('.play-btn')?.classList.add('hidden');
    mainEl.appendChild(iframe);
  }

  document.querySelectorAll<HTMLElement>('.exercice').forEach(card => {
    const mainEl = card.querySelector<HTMLElement>('.main-video');
    if (!mainEl) return;
    watchThumbnail(mainEl);

    mainEl.querySelector('.play-btn')?.addEventListener('click', () => playMainVideo(mainEl));

    const caption = card.querySelector('.video-caption');
    const thumbs = card.querySelectorAll<HTMLElement>('.comp-thumb');
    thumbs.forEach(btn => {
      btn.addEventListener('click', () => {
        if (btn.getAttribute('aria-pressed') === 'true') return;
        const index = parseInt(btn.dataset.index ?? '0');
        setMainVideo(mainEl, btn.dataset.videoId!, btn.dataset.videoStart ?? '');
        if (caption) caption.textContent = index === 0 ? 'Vidéo principale' : `Vidéo complémentaire ${index}`;

        thumbs.forEach(t => {
          t.setAttribute('aria-pressed', 'false');
          t.classList.remove('opacity-100', 'ring-accent');
          t.classList.add('opacity-50', 'ring-transparent', 'hover:opacity-80');
        });
        btn.setAttribute('aria-pressed', 'true');
        btn.classList.remove('opacity-50', 'ring-transparent', 'hover:opacity-80');
        btn.classList.add('opacity-100', 'ring-accent');
      });
    });
  });
</script>
