---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import data from '../data/situations.json';
import danaher from '../data/danaher.json';
const base = import.meta.env.BASE_URL;

const themes = Object.entries(data.themes);
const label = 'text-xs font-bold uppercase tracking-[0.12em] text-muted';
const pill = 'press inline-flex items-center min-h-11 px-4 rounded-full border border-line text-sm font-semibold text-muted cursor-pointer hover:text-fg peer-checked:bg-fg peer-checked:text-bg peer-checked:border-fg peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-accent peer-focus-visible:outline-offset-[3px]';
const field = 'w-full min-h-11 px-4 rounded-full border border-line bg-surface text-base text-fg placeholder:text-faint transition-colors duration-150 hover:border-muted';
const btn = 'press inline-flex items-center justify-center gap-1.5 min-h-11 px-4 rounded-full border border-line text-sm font-semibold hover:border-muted';
const startCls = 'press inline-flex items-center justify-center gap-2 min-h-12 px-4 rounded-full bg-accent-strong text-white font-bold whitespace-nowrap disabled:opacity-40 disabled:cursor-not-allowed';
const stepBtn = 'press size-11 shrink-0 grid place-items-center rounded-full border border-line text-xl font-bold leading-none hover:border-muted disabled:opacity-40 disabled:pointer-events-none';

const steppers = [
  { key: 'rounds', titre: 'Rounds', moins: 'Moins de rounds', plus: 'Plus de rounds' },
  { key: 'roundSec', titre: 'Durée du round', moins: 'Raccourcir le round', plus: 'Allonger le round' },
  { key: 'restSec', titre: 'Repos', moins: 'Raccourcir le repos', plus: 'Allonger le repos' },
];
const groupes = [
  { name: 'format', titre: 'Format', options: [['group', 'Tout le monde en même temps'], ['kot', 'Roi du tapis'], ['danaher', 'Méthode Danaher']] },
  { name: 'disc', titre: 'Discipline', options: [['all', 'Tout'], ['NOGI', 'NOGI'], ['MMA', 'MMA']] },
  { name: 'level', titre: 'Niveau', options: [['deb', 'Débutant'], ['conf', 'Confirmé']] },
];
const [format, disc, level] = groupes;
// Programmes de la méthode Danaher (src/data/danaher.json)
const programmes = [['dds', danaher.seance_dds.nom], ['esc', danaher.echappements_dabord.nom], ['reb', danaher.a_rebours.nom]];
---

<Layout
  title="Situations de sparring"
  description={`Sparring à thème NOGI et MMA : ${data.positions.length} positions tirées au sort, chrono de rounds et roi du tapis.`}
>
  <!-- Le menu du site indique déjà la page et ramène à l'accueil : titre réservé aux lecteurs d'écran -->
  <h1 class="sr-only">Situations de sparring</h1>

  <section aria-labelledby="h-apercu" class="max-w-site mx-auto px-4 md:px-8 pt-3 pb-10 lg:pt-8">
    <div class="max-w-[720px]">
      <h2 id="h-apercu" class="sr-only">Carte tirée au sort</h2>
      <div id="preview" aria-live="polite"></div>
      <!-- Les deux libellés complets demandent environ 400 px : en dessous, « Autre carte », puis sans l'icône ▶ -->
      <div class="mt-3 grid grid-cols-[auto_minmax(0,1fr)] gap-2">
        <button id="redraw" type="button" aria-label="Tirer une autre carte" class={`${btn} min-h-12 whitespace-nowrap max-[389px]:px-3`}>
          <Icon name="shuffle" class="size-4 shrink-0" />
          <span class="min-[480px]:hidden" aria-hidden="true">Autre carte</span><span class="hidden min-[480px]:inline" aria-hidden="true">Tirer une autre carte</span>
        </button>
        <button id="start-main" type="button" class={`start-btn ${startCls} max-[389px]:px-3`}><Icon name="play" class="size-4 shrink-0 max-[389px]:hidden" /> Démarrer la séance</button>
      </div>
      <p class="mt-3 text-sm text-muted">
        <span id="recap" class="tabular-nums"></span>
        <a href="#h-seance" class="ml-1 font-semibold text-fg underline underline-offset-4 decoration-line hover:decoration-fg transition-colors duration-150">Modifier</a>
      </p>
    </div>
  </section>

  <div class="max-w-site mx-auto px-4 md:px-8 pb-28">
    <!-- Réglages sous la carte : séance, paquet, situations du club -->
    <div class="max-w-[720px] min-w-0 flex flex-col gap-12">
      <section aria-labelledby="h-seance">
        <h2 id="h-seance" class={`${label} scroll-mt-20`}>Séance</h2>
        <fieldset class="mt-4">
          <legend class="sr-only">{format.titre}</legend>
          <div class="flex flex-wrap gap-2">
            {format.options.map(([v, t]) => (
              <label><input type="radio" name={format.name} value={v} class="peer sr-only" /><span class={pill}>{t}</span></label>
            ))}
          </div>
        </fieldset>
        <div id="danaher-opts" class="mt-4 flex flex-col gap-4">
          <fieldset>
            <legend class="mb-2 font-semibold">Programme</legend>
            <div class="flex flex-wrap gap-2">
              {programmes.map(([v, t]) => (
                <label><input type="radio" name="prog" value={v} class="peer sr-only" /><span class={pill}>{t}</span></label>
              ))}
            </div>
          </fieldset>
          <p id="prog-desc" class="text-sm text-muted"></p>
          <div id="chain-row">
            <label for="chain" class="block mb-2 font-semibold">Chaîne</label>
            <select id="chain" class={`${field} sm:max-w-xs cursor-pointer`}></select>
          </div>
        </div>
        <div class="mt-5">
          {steppers.map(s => (
            <div class="flex items-center justify-between gap-3 py-2.5 border-t border-line">
              <span id={`lbl-${s.key}`} class="font-semibold">{s.titre}</span>
              <div class="flex items-center gap-1.5" role="group" aria-labelledby={`lbl-${s.key}`}>
                <button type="button" class={stepBtn} data-step={s.key} data-dir="-1" aria-label={s.moins}>−</button>
                <output id={`out-${s.key}`} class="w-[4.5rem] text-center font-display text-[30px] leading-none tabular-nums !normal-case" aria-live="polite"></output>
                <button type="button" class={stepBtn} data-step={s.key} data-dir="1" aria-label={s.plus}>+</button>
              </div>
            </div>
          ))}
          <div id="group-opts">
            <label class="flex items-center justify-between gap-3 py-2.5 min-h-[66px] border-t border-line cursor-pointer">
              <span class="font-semibold">Inverser les rôles à mi-round</span>
              <input id="swap" type="checkbox" class="size-[22px] shrink-0 accent-accent-strong cursor-pointer" />
            </label>
            <label id="partner-row" class="flex items-center justify-between gap-3 py-2.5 min-h-[66px] border-t border-line cursor-pointer has-[:disabled]:cursor-not-allowed">
              <span class="flex flex-col">
                <span class="font-semibold">Changer de partenaire à chaque round</span>
                <span id="partner-note" class="text-sm text-muted">nécessite un repos</span>
              </span>
              <input id="partner" type="checkbox" class="size-[22px] shrink-0 accent-accent-strong cursor-pointer disabled:cursor-not-allowed disabled:opacity-40" />
            </label>
            <label id="bad-row" class="flex items-center justify-between gap-3 py-2.5 min-h-[66px] border-t border-line cursor-pointer">
              <span class="font-semibold">1 round sur 3 en mauvaise position</span>
              <input id="bad" type="checkbox" class="size-[22px] shrink-0 accent-accent-strong cursor-pointer" />
            </label>
          </div>
          <label class="flex items-center justify-between gap-3 py-2.5 min-h-[66px] border-t border-line cursor-pointer">
            <span class="flex flex-col">
              <span class="font-semibold">Durée surprise</span>
              <span class="text-sm text-muted">Chaque round dure entre 2/3 et 4/3 de la durée choisie</span>
            </span>
            <input id="surprise" type="checkbox" class="size-[22px] shrink-0 accent-accent-strong cursor-pointer" />
          </label>
          <div class="border-t border-line"></div>
        </div>
      </section>

      <section aria-labelledby="h-paquet">
        <h2 id="h-paquet" class={label}>Paquet</h2>
        <div class="mt-4 flex flex-col gap-5">
          {[disc, level].map(g => (
            <fieldset>
              <legend class="mb-2 font-semibold">{g.titre}</legend>
              <div class="flex flex-wrap gap-2">
                {g.options.map(([v, t]) => (
                  <label><input type="radio" name={g.name} value={v} class="peer sr-only" /><span class={pill}>{t}</span></label>
                ))}
              </div>
            </fieldset>
          ))}
          <div>
            <label for="theme" class="block mb-2 font-semibold">Thème de la séance</label>
            <select id="theme" class={`${field} sm:max-w-xs cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed`}>
              <option value="all">Tous les thèmes</option>
              {themes.map(([k, t]) => <option value={k}>{t}</option>)}
            </select>
            <p id="theme-note" class="mt-2 text-sm text-muted">Défini par le programme Danaher</p>
          </div>
        </div>
      </section>

      <section aria-labelledby="h-club">
        <h2 id="h-club" class={label}>Situations du club</h2>
        <p class="mt-3 text-muted">Ajoute vos propres positions au paquet. Laisse le rôle B vide si les deux combattants ont le même rôle.</p>
        <form id="add-club" class="mt-4 grid gap-2 sm:grid-cols-2">
          <label class="sm:col-span-2"><span class="sr-only">Nom de la position</span><input id="c-p" class={field} placeholder="Nom de la position" maxlength="60" required /></label>
          <label><span class="sr-only">Thème</span>
            <select id="c-th" class={`${field} cursor-pointer`}>{themes.map(([k, t]) => <option value={k}>{t}</option>)}</select>
          </label>
          <label><span class="sr-only">Discipline</span>
            <select id="c-d" class={`${field} cursor-pointer`}>
              <option value="NOGI MMA">NOGI et MMA</option><option value="NOGI">NOGI</option><option value="MMA">MMA</option>
            </select>
          </label>
          <label><span class="sr-only">Rôle A</span><input id="c-ra" class={field} placeholder="Rôle A (ex. Dessous)" maxlength="30" /></label>
          <label><span class="sr-only">Objectif A</span><input id="c-ga" class={field} placeholder="Objectif A" maxlength="80" /></label>
          <label><span class="sr-only">Rôle B</span><input id="c-rb" class={field} placeholder="Rôle B (ex. Dessus)" maxlength="30" /></label>
          <label><span class="sr-only">Objectif B</span><input id="c-gb" class={field} placeholder="Objectif B" maxlength="80" /></label>
          <div class="sm:col-span-2 flex flex-wrap items-center gap-x-6 gap-y-1">
            <label class="inline-flex items-center gap-2.5 min-h-11 cursor-pointer font-semibold"><input id="c-st" type="checkbox" class="size-5 accent-accent-strong" /> Debout</label>
            <label class="inline-flex items-center gap-2.5 min-h-11 cursor-pointer font-semibold"><input id="c-lv" type="checkbox" class="size-5 accent-accent-strong" /> Confirmés seulement</label>
            <button type="submit" class={`${btn} ml-auto`}><Icon name="plus" class="size-4" /> Ajouter au paquet</button>
          </div>
        </form>
        <ul id="club" class="mt-4"></ul>
      </section>
    </div>
  </div>

  <div id="start-bar" class="sit-startbar fixed inset-x-0 bottom-0 z-[5] border-t border-line bg-bg/90 backdrop-blur-md pb-[env(safe-area-inset-bottom)]" inert>
    <div class="max-w-site mx-auto px-4 md:px-8 py-3 flex items-center justify-between gap-4">
      <p id="summary" class="min-w-0 text-sm font-semibold text-muted tabular-nums"></p>
      <button id="start" type="button" class={`start-btn shrink-0 ${startCls}`}>
        <Icon name="play" class="size-4" /> Démarrer
      </button>
    </div>
  </div>

  <!-- Écran de séance -->
  <div id="session" class="fixed inset-0 z-50 bg-bg text-fg flex flex-col overflow-y-auto overscroll-contain" role="dialog" aria-modal="true" aria-label="Séance de sparring" hidden>
    <div id="live" class="flex-1 flex flex-col">
      <div id="band" class="sit-band">
        <div class="max-w-site mx-auto px-4 md:px-8 h-14 flex items-center justify-between gap-4">
          <p id="phase-label" class="text-sm font-bold uppercase tracking-[0.12em]" aria-live="polite"></p>
          <p id="round-label" class="font-display text-2xl tabular-nums"></p>
        </div>
      </div>
      <div id="session-grid" class="flex-1 w-full max-w-site mx-auto px-4 md:px-8 py-4 lg:py-8 grid gap-6 content-start lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:grid-rows-[auto_1fr] lg:gap-x-12">
        <div id="timer-box" class="min-w-0 lg:col-start-1 lg:row-start-1">
          <p id="timer" class="sit-timer font-display tabular-nums" role="timer">0:00</p>
          <p id="flash" class="sit-flash" aria-live="assertive"></p>
        </div>
        <div id="card-box" class="min-w-0 lg:col-start-2 lg:row-start-1 lg:row-span-2">
          <p id="card-label" class={label}></p>
          <div id="session-card" class="mt-2"></div>
        </div>
        <div id="people" class="min-w-0 lg:col-start-1 lg:row-start-2"></div>
      </div>
      <div class="sticky bottom-0 border-t border-line bg-bg/90 backdrop-blur-md pb-[env(safe-area-inset-bottom)]">
        <div class="max-w-site mx-auto px-2 sm:px-4 md:px-8 py-2 grid grid-cols-5 gap-1 sm:flex sm:flex-wrap sm:justify-center sm:gap-2">
          <button id="s-pause" type="button" class="sit-ctrl press">
            <span data-icon="pause"><Icon name="pause" /></span><span data-icon="play" hidden><Icon name="play" /></span>
            <span id="s-pause-text">Pause</span>
          </button>
          <button id="s-skip" type="button" class="sit-ctrl press"><Icon name="skip" /><span>Passer</span></button>
          <button id="s-card" type="button" class="sit-ctrl press"><Icon name="shuffle" /><span>Nouvelle carte</span></button>
          <button id="s-wall" type="button" class="sit-ctrl press" aria-pressed="false"><Icon name="expand" /><span>Mode mur</span></button>
          <button id="s-stop" type="button" class="sit-ctrl press"><Icon name="x" /><span id="s-stop-text">Arrêter</span></button>
        </div>
      </div>
    </div>

    <div id="end" class="flex-1 w-full max-w-site mx-auto px-4 md:px-8 py-10 lg:py-16" hidden>
      <p class={label}>Séance terminée</p>
      <p class="mt-2 font-display text-[clamp(48px,10vw,96px)]">Bien <span class="text-accent">joué</span></p>
      <p id="end-debrief" class="sit-debrief mt-6 max-w-[40ch]">Débrief : raconte ton round à ton partenaire, ce qui a marché et où tu t'es fait prendre</p>
      <div class="mt-8 grid gap-10 lg:grid-cols-2 lg:gap-16">
        <div id="end-kot" class="min-w-0" hidden></div>
        <div>
          <p class={label}>Situations travaillées</p>
          <ol id="end-list" class="mt-3"></ol>
        </div>
      </div>
      <div class="mt-10 flex flex-wrap gap-3">
        <button id="relaunch" type="button" class="press inline-flex items-center gap-2 min-h-12 px-6 rounded-full bg-accent-strong text-white font-bold"><Icon name="play" class="size-4" /> Relancer les mêmes réglages</button>
        <button id="back" type="button" class={`${btn} min-h-12 px-6`}><Icon name="arrow-left" class="size-4" /> Retour aux réglages</button>
      </div>
    </div>
  </div>

  <template id="ico-trash"><Icon name="trash" class="size-[18px]" /></template>
</Layout>

<script>
  import data from '../data/situations.json';
  import danaher from '../data/danaher.json';

  type Pos = { p: string; th: string; d: string; ra: string; rb: string; ga: string[]; gb: string[]; st?: boolean; sym?: boolean; lv?: string; club?: string };
  type Con = { t: string; d: string; g?: boolean; s?: boolean; a?: boolean; lv?: string; sauf?: string[] };
  type Settings = {
    format: 'group' | 'kot' | 'danaher'; prog: 'dds' | 'esc' | 'reb'; chain: string;
    rounds: number; roundSec: number; restSec: number; swap: boolean; partner: boolean; surprise: boolean; bad: boolean;
    disc: string; level: string; theme: string;
  };
  // tag : étiquette à la place du thème ; extra : étiquette en plus ; ruleLabel : Contrainte, Règle ou Reset
  type Card = { p: string; th: string; disc: string; ra: string; rb: string; goalA: string; goalB: string; c: string; sym: boolean; conf: boolean; deb: boolean; tag?: string; extra?: string; ruleLabel?: string };
  type DdsRound = { p: string; d: string; ra: string; rb: string; ga: string; gb: string; reset: string };
  type Chain = { nom: string; d: string; etapes: string[] };

  const THEMES = data.themes as Record<string, string>;
  const BUILTIN = data.positions as Pos[];
  const CONS = data.contraintes as Con[];
  const KEY = 'slamm-situations-v1';
  const OPTS: Record<string, number[]> = {
    rounds: Array.from({ length: 18 }, (_, i) => i + 3),
    roundSec: [30, 45, 60, 90, 120, 150, 180, 240, 300, 360],
    restSec: [0, 10, 15, 20, 30, 45, 60],
  };
  const PREP = 10;
  const DEBRIEF_MIN = 15; // repos minimum pour afficher le débrief pendant le repos
  const DEBRIEF = 'Débrief : raconte ton round à ton partenaire, ce qui a marché et où tu t\'es fait prendre';
  const DDS = danaher.seance_dds;
  const ESC = danaher.echappements_dabord;
  const CHAINS = danaher.a_rebours.chaines as Chain[];
  const BAD = danaher.mauvaises_positions as string[];
  const PROG_LABEL: Record<string, string> = { dds: 'Séance type', esc: ESC.nom, reb: danaher.a_rebours.nom };
  const PROG_DESC: Record<string, string> = { dds: DDS.description, esc: ESC.description, reb: danaher.a_rebours.description };
  const DEFAULTS: Settings = {
    format: 'group', prog: 'dds', chain: CHAINS[0].nom,
    rounds: 8, roundSec: 60, restSec: 20, swap: true, partner: true, surprise: false, bad: false,
    disc: 'all', level: 'deb', theme: 'all',
  };

  /* ---------- Stockage ---------- */
  // Le champ members des anciennes versions est ignoré, puis disparaît à la prochaine sauvegarde
  const store = { settings: { ...DEFAULTS }, club: [] as Pos[] };
  try {
    const raw = JSON.parse(localStorage.getItem(KEY) || 'null');
    if (raw && typeof raw === 'object') {
      const s = { ...DEFAULTS, ...(raw.settings || {}) };
      for (const k of ['rounds', 'roundSec', 'restSec']) if (!OPTS[k].includes(s[k])) s[k] = DEFAULTS[k];
      if (s.format === 'pairs') s.format = 'group';
      if (!['group', 'kot', 'danaher'].includes(s.format)) s.format = DEFAULTS.format;
      if (!['dds', 'esc', 'reb'].includes(s.prog)) s.prog = DEFAULTS.prog;
      if (!CHAINS.some(c => c.nom === s.chain)) s.chain = DEFAULTS.chain;
      s.surprise = !!s.surprise;
      s.bad = !!s.bad;
      if (!['all', 'NOGI', 'MMA'].includes(s.disc)) s.disc = DEFAULTS.disc;
      if (!['deb', 'conf'].includes(s.level)) s.level = DEFAULTS.level;
      if (s.theme !== 'all' && !THEMES[s.theme]) s.theme = 'all';
      s.swap = !!s.swap;
      s.partner = s.partner !== false;
      store.settings = s;
      if (Array.isArray(raw.club)) store.club = raw.club.filter((p: Pos) => p && typeof p.p === 'string' && THEMES[p.th] && Array.isArray(p.ga) && Array.isArray(p.gb));
    }
  } catch { /* stockage indisponible : on garde les valeurs par défaut */ }
  const save = () => { try { localStorage.setItem(KEY, JSON.stringify(store)); } catch { /* quota ou navigation privée */ } };

  /* ---------- Outils ---------- */
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);
  const pick = <T,>(a: T[]): T => a[Math.floor(Math.random() * a.length)];
  const fmt = (sec: number) => `${Math.floor(sec / 60)}:${String(sec % 60).padStart(2, '0')}`;
  const trashIcon = ($('ico-trash') as HTMLTemplateElement).innerHTML;

  /* ---------- Paquet ---------- */
  const allPositions = () => [...BUILTIN, ...store.club];
  const discsOf = (p: Pos) => p.d.split(' ');
  const matchesDeck = (p: Pos, s: Settings) =>
    (s.disc === 'all' || discsOf(p).includes(s.disc)) && (s.level === 'conf' || p.lv !== 'conf');
  function eligible(s: Settings) {
    return allPositions().filter(p => matchesDeck(p, s) && (s.theme === 'all' || p.th === s.theme));
  }
  // Une contrainte ne contredit jamais la position
  function fits(c: Con, p: Pos, disc: string, level: string) {
    if (c.d !== '*' && c.d !== disc) return false;
    if (c.g && p.st) return false;
    if (c.s && !p.st) return false;
    if (c.a && p.sym) return false;
    if (c.lv && c.lv !== level) return false;
    if (c.sauf && c.sauf.includes(p.th)) return false;
    return true;
  }
  // Carte d'une position donnée, avec une contrainte compatible tirée au sort
  function cardFor(pos: Pos, s: Settings): Card {
    const disc = s.disc === 'all' ? pick(discsOf(pos)) : s.disc;
    const cons = CONS.filter(c => fits(c, pos, disc, s.level));
    const sym = !!pos.sym;
    const ra = sym ? 'Combattant A' : pos.ra;
    const rb = sym ? 'Combattant B' : pos.rb;
    const c = cons.length ? pick(cons).t.replaceAll('{A}', ra).replaceAll('{B}', rb) : 'Travail libre de la position';
    return { p: pos.p, th: pos.th, disc, ra, rb, goalA: pick(pos.ga), goalB: pick(pos.gb), c, sym, conf: pos.lv === 'conf', deb: s.level === 'deb' };
  }
  function pickPos(pool: Pos[], avoid: string[]) {
    const fresh = pool.filter(p => !avoid.includes(p.p));
    return pick(fresh.length ? fresh : pool);
  }
  function draw(s: Settings, avoid: string[] = []): Card | null {
    const pool = eligible(s);
    return pool.length ? cardFor(pickPos(pool, avoid), s) : null;
  }
  const byName = (n: string) => allPositions().find(p => p.p === n);
  // Chaînes « À rebours » disponibles pour la discipline choisie
  const chainsFor = (s: Settings) => CHAINS.filter(c => s.disc === 'all' || c.d.split(' ').includes(s.disc));
  const currentChain = (s: Settings) => { const list = chainsFor(s); return list.find(c => c.nom === s.chain) || list[0] || null; };
  const escPool = (s: Settings) => ESC.positions.map(byName).filter((p): p is Pos => !!p && matchesDeck(p, s));
  const badPool = (s: Settings) => BAD.map(byName).filter((p): p is Pos => !!p && matchesDeck(p, s));

  // Carte du round n (à partir de 1) selon le format et le programme
  function cardForRound(s: Settings, round: number, avoid: string[] = [], badRound = false): Card | null {
    if (s.format === 'danaher') {
      if (s.prog === 'dds') {
        const list = DDS.rounds as DdsRound[];
        const i = (round - 1) % list.length, r = list[i];
        const sym = r.ra === 'Combattant A';
        return { p: r.p, th: '', disc: s.disc === 'all' ? 'NOGI MMA' : s.disc, ra: r.ra, rb: r.rb, goalA: r.ga, goalB: r.gb,
          c: r.reset, ruleLabel: 'Reset', sym, conf: false, deb: s.level === 'deb', tag: `Séance type · ${i + 1} / ${list.length}` };
      }
      if (s.prog === 'esc') {
        const pool = escPool(s);
        if (!pool.length) return null;
        const card = cardFor(pickPos(pool, avoid), s);
        return { ...card, c: s.level === 'deb' ? ESC.regle_debutant : ESC.regle_confirme, ruleLabel: 'Règle', tag: ESC.nom };
      }
      const chain = currentChain(s);
      if (!chain) return null;
      const i = (round - 1) % chain.etapes.length, pos = byName(chain.etapes[i]);
      if (!pos) return null;
      return { ...cardFor(pos, s), tag: `À rebours · ${chain.nom}`, extra: `Étape ${i + 1} / ${chain.etapes.length}` };
    }
    if (badRound) {
      const pool = badPool(s);
      if (pool.length) return { ...cardFor(pickPos(pool, avoid), s), extra: 'Mauvaise position' };
    }
    return draw(s, avoid);
  }
  const hasCards = (s: Settings) => s.format === 'danaher'
    ? (s.prog === 'dds' || (s.prog === 'esc' ? escPool(s).length > 0 : !!currentChain(s)))
    : eligible(s).length > 0;

  // Un round sur trois en mauvaise position : un round au hasard par bloc de 3, jamais deux à la suite
  function badPlan(rounds: number) {
    const plan = new Set<number>();
    for (let start = 1; start <= rounds; start += 3) {
      const size = Math.min(3, rounds - start + 1);
      if (size < 3 && Math.random() >= size / 3) continue;
      const options = Array.from({ length: size }, (_, k) => start + k).filter(r => !plan.has(r - 1));
      if (options.length) plan.add(pick(options));
    }
    return plan;
  }
  // preview : carte d'aperçu en haut de page, sans le rappel débutant (affiché dans le résumé)
  function cardHTML(card: Card | null, names?: { a?: string; b?: string; aNote?: string; bNote?: string }, preview = false) {
    if (!card) return '<div class="sit-card sit-empty">Aucune position ne correspond à ces réglages. Change la discipline, le niveau ou le thème.</div>';
    const half = (x: 'a' | 'b', role: string, goal: string, name?: string, note?: string) => `
      <div class="sit-half">
        <p class="sit-half-head">${card.sym ? '' : `<span class="sit-letter sit-letter-${x}">${x.toUpperCase()}</span>`}<span class="sit-role">${esc(role)}</span></p>
        ${name ? `<p class="sit-half-name">${esc(name)}${note ? ` <span class="sit-half-note">${esc(note)}</span>` : ''}</p>` : ''}
        <p class="sit-goal">${esc(goal)}</p>
      </div>`;
    return `<article class="sit-card${preview ? ' sit-card-preview' : ''}">
      <div class="sit-card-meta">
        <span class="sit-tag sit-tag-strong">${esc(card.disc)}</span>
        <span class="sit-tag">${esc(card.tag || THEMES[card.th] || card.th)}</span>
        ${card.extra ? `<span class="sit-tag sit-tag-accent">${esc(card.extra)}</span>` : ''}
        ${card.conf ? '<span class="sit-tag">Confirmés</span>' : ''}
      </div>
      <h3 class="sit-pos font-display">${esc(card.p)}</h3>
      <div class="sit-halves">${half('a', card.ra, card.goalA, names?.a, names?.aNote)}${half('b', card.rb, card.goalB, names?.b, names?.bNote)}</div>
      <div class="sit-rule"><p class="sit-label">${esc(card.ruleLabel || 'Contrainte')}</p><p class="sit-rule-text">${esc(card.c)}</p></div>
      ${card.deb && !preview ? '<p class="sit-safety">Pas de clés de talon, intensité contrôlée, on tape tôt</p>' : ''}
    </article>`;
  }
  function flip(el: HTMLElement) {
    const card = el.querySelector('.sit-card') as HTMLElement | null;
    if (!card) return;
    card.classList.remove('sit-flip');
    void card.offsetWidth;
    card.classList.add('sit-flip');
  }

  /* ---------- Réglages ---------- */
  const S = () => store.settings;

  // Menu des thèmes : nombre de positions selon la discipline et le niveau, thèmes vides désactivés
  function updateThemeOptions() {
    const s = S();
    const counts: Record<string, number> = {};
    let total = 0;
    for (const p of allPositions()) if (matchesDeck(p, s)) { counts[p.th] = (counts[p.th] || 0) + 1; total++; }
    const select = $<HTMLSelectElement>('theme');
    for (const o of Array.from(select.options)) {
      const n = o.value === 'all' ? total : counts[o.value] || 0;
      const name = o.value === 'all' ? 'Tous les thèmes' : THEMES[o.value];
      o.textContent = `${name} (${n})`;
      o.disabled = o.value !== 'all' && n === 0;
    }
    // Le thème choisi est devenu vide : retour à « Tous les thèmes »
    if (s.theme !== 'all' && !counts[s.theme]) { s.theme = 'all'; save(); }
    select.value = s.theme;
  }

  function syncSettingsUI() {
    const s = S();
    for (const name of ['format', 'disc', 'level', 'prog']) {
      document.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`).forEach(i => { i.checked = i.value === (s as any)[name]; });
    }
    $('out-rounds').textContent = String(s.rounds);
    $('out-roundSec').textContent = fmt(s.roundSec);
    $('out-restSec').textContent = s.restSec < 60 ? `${s.restSec} s` : fmt(s.restSec);
    document.querySelectorAll<HTMLButtonElement>('[data-step]').forEach(b => {
      const k = b.dataset.step as string, o = OPTS[k], i = o.indexOf((s as any)[k]);
      b.disabled = b.dataset.dir === '-1' ? i <= 0 : i >= o.length - 1;
    });
    const isDanaher = s.format === 'danaher';
    $('danaher-opts').hidden = !isDanaher;
    $('prog-desc').textContent = PROG_DESC[s.prog];
    $('chain-row').hidden = !(isDanaher && s.prog === 'reb');
    // Chaînes filtrées selon la discipline
    const chains = chainsFor(s), chainSel = $<HTMLSelectElement>('chain');
    chainSel.innerHTML = chains.map(c => `<option value="${esc(c.nom)}">${esc(c.nom)} (${c.etapes.length} étapes)</option>`).join('');
    const chain = currentChain(s);
    if (chain && chain.nom !== s.chain) { s.chain = chain.nom; save(); }
    if (chain) chainSel.value = chain.nom;
    // Options de séance
    $<HTMLInputElement>('swap').checked = s.swap;
    const noRest = s.restSec === 0;
    const partner = $<HTMLInputElement>('partner');
    partner.checked = s.partner && !noRest;
    partner.disabled = noRest;
    $('partner-note').hidden = !noRest;
    $<HTMLInputElement>('bad').checked = s.bad;
    $('bad-row').hidden = s.format !== 'group';
    $<HTMLInputElement>('surprise').checked = s.surprise;
    $('group-opts').hidden = s.format === 'kot';
    // Thème : fixé par le programme en méthode Danaher
    $<HTMLSelectElement>('theme').disabled = isDanaher;
    $('theme-note').hidden = !isDanaher;
    updateThemeOptions();
    updateSummary();
  }
  const restLabel = (s: Settings) => s.restSec ? `, repos ${fmt(s.restSec)}` : ' sans repos';
  function updateSummary() {
    const s = S();
    const total = PREP + s.rounds * s.roundSec + (s.rounds - 1) * s.restSec;
    const empty = !hasCards(s);
    const parts = [`${s.rounds} rounds de ${fmt(s.roundSec)}`, `environ ${Math.max(1, Math.round(total / 60))} min`];
    if (s.surprise) parts.push('durée surprise');
    if (empty) parts.push('aucune carte ne correspond aux filtres');
    $('summary').textContent = parts.join(' · ');
    document.querySelectorAll<HTMLButtonElement>('.start-btn').forEach(b => { b.disabled = empty; });
    // Résumé des réglages sous la carte
    const discLabel = s.disc === 'all' ? 'NOGI et MMA' : s.disc;
    const levelLabel = s.level === 'deb' ? 'Débutant : pas de clés de talon, on tape tôt' : 'Confirmé';
    const durations = `${s.rounds} × ${fmt(s.roundSec)}${restLabel(s)}`;
    let recap: string[];
    if (s.format === 'danaher') {
      const prog = s.prog === 'reb' ? `${PROG_LABEL.reb} : ${currentChain(s)?.nom ?? '—'}` : PROG_LABEL[s.prog];
      recap = s.prog === 'dds' ? ['Méthode Danaher', prog, durations] : ['Méthode Danaher', prog, discLabel, levelLabel, durations];
    } else {
      recap = [discLabel, levelLabel, s.theme === 'all' ? 'Tous les thèmes' : THEMES[s.theme], durations,
        s.format === 'kot' ? 'Roi du tapis' : 'Tout le monde en même temps'];
      if (s.format === 'group' && s.bad) recap.push('1 round sur 3 en mauvaise position');
    }
    if (s.surprise) recap.push('durée surprise');
    $('recap').textContent = recap.join(' · ');
  }
  // Aperçu : en Séance type et À rebours, « Tirer une autre carte » montre la carte suivante dans l'ordre
  let previewRound = 1;
  let previewCard: Card | null = null;
  function renderPreview(animate = true) {
    const el = $('preview');
    previewCard = cardForRound(S(), previewRound, previewCard ? [previewCard.p] : []);
    el.innerHTML = cardHTML(previewCard, undefined, true);
    if (animate) flip(el);
  }
  function renderClub() {
    $('club').innerHTML = store.club.map((p, i) => `
      <li class="sit-club">
        <div class="min-w-0"><p class="sit-club-name">${esc(p.p)}</p>
        <p class="sit-club-meta">${esc(THEMES[p.th])} · ${esc(p.d.replace(' ', ' et '))}${p.st ? ' · Debout' : ''}${p.lv === 'conf' ? ' · Confirmés' : ''}</p></div>
        <button type="button" class="sit-iconbtn press" data-idx="${i}" aria-label="Retirer ${esc(p.p)} du paquet">${trashIcon}</button>
      </li>`).join('');
    updateThemeOptions();
    updateSummary();
  }

  // Choisir la Séance type règle une seule fois les durées et décoche l'inversion (les resets inversent déjà les rôles)
  function applyDdsDefaults() {
    const s = S();
    s.rounds = DDS.rounds_defaut; s.roundSec = DDS.duree_defaut; s.restSec = DDS.repos_defaut; s.swap = false;
  }
  document.querySelectorAll<HTMLInputElement>('input[name="format"], input[name="disc"], input[name="level"], input[name="prog"]').forEach(i => {
    i.addEventListener('change', () => {
      const s = S();
      (s as any)[i.name] = i.value;
      const choseDds = (i.name === 'prog' && i.value === 'dds') || (i.name === 'format' && i.value === 'danaher' && s.prog === 'dds');
      if (choseDds) applyDdsDefaults();
      if (i.name === 'format' || i.name === 'prog') previewRound = 1;
      save(); syncSettingsUI(); renderPreview();
    });
  });
  $<HTMLSelectElement>('chain').addEventListener('change', e => { S().chain = (e.target as HTMLSelectElement).value; previewRound = 1; save(); syncSettingsUI(); renderPreview(); });
  $<HTMLInputElement>('bad').addEventListener('change', e => { S().bad = (e.target as HTMLInputElement).checked; save(); updateSummary(); });
  $<HTMLInputElement>('surprise').addEventListener('change', e => { S().surprise = (e.target as HTMLInputElement).checked; save(); updateSummary(); });
  document.querySelectorAll<HTMLButtonElement>('[data-step]').forEach(b => b.addEventListener('click', () => {
    const k = b.dataset.step as string, o = OPTS[k];
    const i = Math.min(o.length - 1, Math.max(0, o.indexOf((S() as any)[k]) + Number(b.dataset.dir)));
    (S() as any)[k] = o[i]; save(); syncSettingsUI();
  }));
  $<HTMLInputElement>('swap').addEventListener('change', e => { S().swap = (e.target as HTMLInputElement).checked; save(); });
  $<HTMLInputElement>('partner').addEventListener('change', e => { S().partner = (e.target as HTMLInputElement).checked; save(); });
  $<HTMLSelectElement>('theme').addEventListener('change', e => { S().theme = (e.target as HTMLSelectElement).value; save(); updateSummary(); renderPreview(); });
  $('redraw').addEventListener('click', () => {
    const s = S();
    if (s.format === 'danaher' && s.prog !== 'esc') previewRound++;
    renderPreview();
  });

  $<HTMLFormElement>('add-club').addEventListener('submit', e => {
    e.preventDefault();
    const v = (id: string) => $<HTMLInputElement>(id).value.trim();
    const p = v('c-p').slice(0, 60);
    if (!p) return;
    const ra = v('c-ra').slice(0, 30), rb = v('c-rb').slice(0, 30);
    const sym = !ra || !rb || ra.toLowerCase() === rb.toLowerCase();
    const ga = v('c-ga').slice(0, 80) || 'Prendre le dessus';
    const gb = v('c-gb').slice(0, 80) || (sym ? ga : 'Prendre le dessus');
    const pos: Pos = { p, th: v('c-th'), d: v('c-d'), ra: sym ? 'Combattant A' : ra, rb: sym ? 'Combattant B' : rb, ga: [ga], gb: [sym ? ga : gb], club: '1' };
    if (sym) pos.sym = true;
    if ($<HTMLInputElement>('c-st').checked) pos.st = true;
    if ($<HTMLInputElement>('c-lv').checked) pos.lv = 'conf';
    store.club.push(pos);
    save(); renderClub();
    (e.target as HTMLFormElement).reset();
    $('c-p').focus();
  });
  $('club').addEventListener('click', e => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-idx]');
    if (!b) return;
    store.club.splice(Number(b.dataset.idx), 1);
    save(); renderClub();
  });

  syncSettingsUI();
  renderClub();
  renderPreview(false);

  /* ---------- Sons (Web Audio, créé au clic sur Démarrer) ---------- */
  let actx: AudioContext | null = null;
  function initAudio() {
    try {
      if (!actx) { const C = window.AudioContext || (window as any).webkitAudioContext; if (C) actx = new C(); }
      actx?.resume();
    } catch { actx = null; }
  }
  function tone(freq: number, dur: number, delay = 0, type: OscillatorType = 'sine', vol = 0.35) {
    if (!actx) return;
    try {
      const t = actx.currentTime + delay, o = actx.createOscillator(), g = actx.createGain();
      o.type = type; o.frequency.value = freq;
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(vol, t + 0.01);
      g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      o.connect(g).connect(actx.destination);
      o.start(t); o.stop(t + dur + 0.05);
    } catch { /* son indisponible */ }
  }
  const sounds = {
    count: () => tone(880, 0.14),
    go: () => tone(1320, 0.5, 0, 'square', 0.25),
    ten: () => { tone(1046, 0.12); tone(1046, 0.12, 0.2); },
    swap: () => { tone(1175, 0.12); tone(1175, 0.12, 0.18); tone(1175, 0.12, 0.36); },
    end: () => { tone(196, 1.1, 0, 'sawtooth', 0.22); tone(147, 1.1, 0, 'sine', 0.35); },
    next: () => tone(990, 0.1),
  };

  /* ---------- Écran allumé ---------- */
  let wakeLock: any = null;
  async function lockScreen() {
    try { if ('wakeLock' in navigator && document.visibilityState === 'visible') wakeLock = await (navigator as any).wakeLock.request('screen'); } catch { wakeLock = null; }
  }
  function releaseScreen() { try { wakeLock?.release(); } catch { /* déjà libéré */ } wakeLock = null; }

  /* ---------- Séance ---------- */
  // Roi du tapis : le roi tient le rôle A, le challenger le rôle B ; on suit la série du roi
  type Kot = { streak: number; best: number };
  type Sess = {
    set: Settings;
    phase: 'prep' | 'work' | 'rest' | 'done'; round: number; dur: number; end: number; prevRem: number;
    paused: boolean; left: number; swapped: boolean;
    card: Card | null; next: Card | null; history: { round: number; card: Card }[];
    kot: Kot | null; snap: Kot | null; decision: 'king' | 'chal' | null;
    badRounds: Set<number>;
  };
  let ses: Sess | null = null;
  let raf = 0, interval = 0, flashTimer = 0, stopTimer = 0, lastShown = -1;
  const overlay = $('session');
  const clone = <T,>(o: T): T => JSON.parse(JSON.stringify(o));

  function kotDecide(k: Kot, kingWins: boolean) {
    // Le roi garde sa place : sa série augmente. Le challenger prend la place : nouveau roi, série de 1
    k.streak = kingWins ? k.streak + 1 : 1;
    k.best = Math.max(k.best, k.streak);
  }

  function startSession() {
    const set = clone(S());
    if (!hasCards(set)) return;
    initAudio();
    const badRounds = set.format === 'group' && set.bad ? badPlan(set.rounds) : new Set<number>();
    ses = {
      set, phase: 'prep', round: 1, dur: 0, end: 0, prevRem: 0, paused: false, left: 0, swapped: false,
      card: null, next: cardForRound(set, 1, [], badRounds.has(1)), history: [],
      kot: set.format === 'kot' ? { streak: 0, best: 0 } : null, snap: null, decision: null,
      badRounds,
    };
    // Séance type : « Nouvelle carte » n'a pas de sens, l'ordre est fixe
    $<HTMLButtonElement>('s-card').disabled = set.format === 'danaher' && set.prog === 'dds';
    overlay.hidden = false;
    $('live').hidden = false; $('end').hidden = true;
    document.documentElement.style.overflow = 'hidden';
    resetStop();
    setPaused(false);
    enterPhase('prep', Date.now());
    lockScreen();
    cancelAnimationFrame(raf); clearInterval(interval);
    const loop = () => { tick(); raf = requestAnimationFrame(loop); };
    raf = requestAnimationFrame(loop);
    // Repli quand l'onglet est en arrière-plan (requestAnimationFrame y est suspendu)
    interval = window.setInterval(tick, 250);
    $('s-pause').focus();
  }

  function enterPhase(phase: Sess['phase'], at: number) {
    if (!ses) return;
    const s = ses;
    s.phase = phase;
    // Durée surprise : entre 2/3 et 4/3 de la durée choisie, à la seconde près
    const workSec = s.set.surprise ? Math.round(s.set.roundSec * (2 / 3 + Math.random() * 2 / 3)) : s.set.roundSec;
    s.dur = phase === 'prep' ? PREP : phase === 'work' ? workSec : s.set.restSec;
    s.end = at + s.dur * 1000;
    s.prevRem = s.dur * 1000;
    s.swapped = false;
    if (phase === 'work') {
      s.card = s.next; s.next = null;
      if (s.card) s.history.push({ round: s.round, card: s.card });
      s.decision = null; s.snap = null;
      sounds.go();
    }
    if (phase === 'rest') s.next = nextCard(s);
    render(true);
  }

  function endWork(at: number) {
    if (!ses) return;
    sounds.end();
    // Roi du tapis : sans clic, le roi garde sa place et sa série augmente (modifiable pendant le repos)
    if (ses.kot) {
      ses.snap = clone(ses.kot);
      kotDecide(ses.kot, true);
      ses.decision = 'king';
    }
    if (ses.round >= ses.set.rounds) finish();
    else if (ses.set.restSec === 0) {
      // Sans repos : le round suivant part aussitôt
      ses.next = nextCard(ses);
      ses.round++;
      enterPhase('work', at);
    } else enterPhase('rest', at);
  }
  const nextCard = (s: Sess) => cardForRound(s.set, s.round + 1, s.history.slice(-3).map(h => h.card.p), s.badRounds.has(s.round + 1));

  function advance(at: number) {
    if (!ses) return;
    if (ses.phase === 'prep') enterPhase('work', at);
    else if (ses.phase === 'work') endWork(at);
    else if (ses.phase === 'rest') { ses.round++; enterPhase('work', at); }
  }

  function crossed(prev: number, rem: number, t: number) { return prev > t && rem <= t && rem > t - 1500; }

  function tick() {
    if (!ses || ses.phase === 'done' || ses.paused) return;
    const now = Date.now();
    // Chrono basé sur l'horloge : si l'onglet a ralenti, on rattrape les phases manquées
    let guard = 0;
    while (ses && ses.phase !== 'done' && now >= ses.end && guard++ < 100) advance(ses.end);
    if (!ses || ses.phase === 'done') return;
    const rem = ses.end - now, prev = ses.prevRem;
    if (ses.phase === 'work') {
      // Durée surprise : pas de double bip à 10 s, seulement le son de fin
      if (!ses.set.surprise && ses.dur > 20 && crossed(prev, rem, 10000)) sounds.ten();
      // Inversion à la moitié de la durée choisie : avec la durée surprise, elle ne trahit pas la fin du round
      const elapsed = ses.dur * 1000 - rem, half = ses.set.roundSec * 500;
      if (ses.set.format !== 'kot' && ses.set.swap && !ses.swapped && elapsed >= half) {
        ses.swapped = true;
        if (elapsed < half + 1500) { sounds.swap(); flash('On inverse les rôles !', 3000); }
        render(false);
      }
    } else {
      for (const t of [3000, 2000, 1000]) if (crossed(prev, rem, t)) sounds.count();
    }
    ses.prevRem = rem;
    showTime(rem);
  }

  function showTime(rem: number) {
    // Durée surprise : le temps restant du round reste caché
    if (ses && ses.phase === 'work' && ses.set.surprise) {
      if (lastShown !== -2) { lastShown = -2; $('timer').textContent = '?'; }
      return;
    }
    const sec = Math.max(0, Math.ceil(rem / 1000));
    if (sec === lastShown) return;
    lastShown = sec;
    $('timer').textContent = fmt(sec);
  }

  function flash(text: string, ms: number) {
    const el = $('flash');
    el.textContent = text;
    el.classList.add('is-on');
    clearTimeout(flashTimer);
    flashTimer = window.setTimeout(() => el.classList.remove('is-on'), ms);
  }

  function render(newCard: boolean) {
    if (!ses) return;
    const s = ses;
    const band = $('band');
    band.dataset.phase = s.phase;
    $('phase-label').textContent = s.paused ? 'En pause' : { prep: 'Préparation', work: 'Travail', rest: 'Repos', done: '' }[s.phase];
    const r = s.phase === 'rest' ? s.round + 1 : s.round;
    $('round-label').textContent = `Round ${r} / ${s.set.rounds}`;
    $('card-label').textContent = s.phase === 'work' ? 'Carte du round' : s.phase === 'prep' ? 'Premier round' : 'Prochain round';

    const card = s.phase === 'work' ? s.card : s.next;
    const names = s.kot ? { a: 'Roi', b: 'Challenger', aNote: `Série ${s.kot.streak}` } : undefined;
    const cardEl = $('session-card');
    cardEl.innerHTML = cardHTML(card, names);
    if (newCard) flip(cardEl);
    $('people').innerHTML = s.kot ? kotHTML() : groupHTML();
    showTime(s.paused ? s.left : s.end - Date.now());
  }

  const debriefHTML = () => `<p class="sit-debrief">${esc(DEBRIEF)}</p>`;
  const showDebriefInRest = (s: Sess) => s.phase === 'rest' && s.set.restSec >= DEBRIEF_MIN;
  function groupHTML() {
    const s = ses as Sess;
    if (s.phase === 'rest') {
      // Sans repos, le changement de partenaire est ignoré (la case est grisée dans les réglages)
      const partner = s.set.partner && s.set.restSec > 0 ? '<p class="sit-partner font-display">Changez de partenaire</p>' : '';
      return partner + (showDebriefInRest(s) ? debriefHTML() : '');
    }
    if (s.phase === 'work' && s.swapped) return '<p class="sit-note">Rôles inversés : A devient B, B devient A</p>';
    return '';
  }

  function kotHTML() {
    const s = ses as Sess, k = s.kot as Kot;
    const streak = `<div class="sit-streak"><p class="sit-label">Série du roi</p><p class="sit-streak-n font-display">${k.streak}</p></div>`;
    if (s.phase === 'work') {
      return `${streak}<p class="sit-label sit-mt">Qui gagne ?</p><div class="sit-kot-btns">
        <button type="button" class="sit-btn press" data-kot="king">Le roi garde sa place</button>
        <button type="button" class="sit-btn press" data-kot="chal">Le challenger prend la place</button></div>`;
    }
    if (s.phase === 'rest' && s.snap) {
      return `${streak}<p class="sit-label sit-mt">Round terminé : qui a gagné ?</p><div class="sit-kot-btns">
        <button type="button" class="sit-btn press" data-kot="king" aria-pressed="${s.decision === 'king'}">Le roi garde sa place</button>
        <button type="button" class="sit-btn press" data-kot="chal" aria-pressed="${s.decision === 'chal'}">Le challenger prend la place</button></div>
        ${showDebriefInRest(s) ? debriefHTML() : ''}`;
    }
    return streak;
  }

  function kotClick(which: 'king' | 'chal') {
    if (!ses || !ses.kot) return;
    const s = ses;
    if (s.phase === 'work') {
      kotDecide(s.kot, which === 'king');
    } else if (s.phase === 'rest' && s.snap && s.decision !== which) {
      // Correction du résultat du round qui vient de finir
      s.kot = clone(s.snap);
      kotDecide(s.kot, which === 'king');
      s.decision = which;
    } else return;
    sounds.next();
    flash('Au suivant !', 2000);
    render(false);
  }
  $('people').addEventListener('click', e => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-kot]');
    if (b) kotClick(b.dataset.kot as 'king' | 'chal');
  });

  function setPaused(p: boolean) {
    $('s-pause-text').textContent = p ? 'Reprendre' : 'Pause';
    ($('s-pause').querySelector('[data-icon="pause"]') as HTMLElement).hidden = p;
    ($('s-pause').querySelector('[data-icon="play"]') as HTMLElement).hidden = !p;
  }
  $('s-pause').addEventListener('click', () => {
    if (!ses || ses.phase === 'done') return;
    initAudio();
    if (ses.paused) { ses.end = Date.now() + ses.left; ses.paused = false; }
    else { ses.left = Math.max(0, ses.end - Date.now()); ses.paused = true; }
    setPaused(ses.paused);
    render(false);
  });
  $('s-skip').addEventListener('click', () => {
    if (!ses || ses.phase === 'done') return;
    const wasPaused = ses.paused;
    ses.paused = false; setPaused(false);
    if (wasPaused) ses.end = Date.now();
    advance(Date.now());
  });
  $('s-card').addEventListener('click', () => {
    if (!ses || ses.phase === 'done') return;
    // Même logique que le plan de séance : en À rebours, même étape et nouvelle contrainte
    const r = ses.phase === 'work' ? ses.round : ses.round + 1;
    const fresh = cardForRound(ses.set, r, [ses.card?.p, ses.next?.p].filter(Boolean) as string[], ses.badRounds.has(r));
    if (ses.phase === 'work') {
      ses.card = fresh;
      const last = ses.history[ses.history.length - 1];
      if (fresh) { if (last && last.round === ses.round) last.card = fresh; else ses.history.push({ round: ses.round, card: fresh }); }
    } else ses.next = fresh;
    render(true);
  });
  $('s-wall').addEventListener('click', () => {
    const on = !overlay.hasAttribute('data-wall');
    overlay.toggleAttribute('data-wall', on);
    $('s-wall').setAttribute('aria-pressed', String(on));
    try {
      if (on && overlay.requestFullscreen && !document.fullscreenElement) overlay.requestFullscreen().catch(() => {});
      if (!on && document.fullscreenElement) document.exitFullscreen().catch(() => {});
    } catch { /* plein écran refusé */ }
  });
  function resetStop() {
    clearTimeout(stopTimer);
    $('s-stop').removeAttribute('data-confirm');
    $('s-stop-text').textContent = 'Arrêter';
  }
  $('s-stop').addEventListener('click', () => {
    const b = $('s-stop');
    if (b.hasAttribute('data-confirm')) { resetStop(); finish(); return; }
    b.setAttribute('data-confirm', '');
    $('s-stop-text').textContent = 'Confirmer';
    stopTimer = window.setTimeout(resetStop, 3000);
  });

  function stopLoop() { cancelAnimationFrame(raf); clearInterval(interval); lastShown = -1; }

  function finish() {
    if (!ses) return;
    ses.phase = 'done';
    stopLoop();
    releaseScreen();
    $('live').hidden = true;
    $('end').hidden = false;
    renderEnd();
    overlay.scrollTop = 0;
    $('relaunch').focus({ preventScroll: true });
  }

  function renderEnd() {
    const s = ses as Sess;
    $('end-list').innerHTML = s.history.length
      ? s.history.map(h => `<li class="sit-hist"><span class="sit-hist-n">${h.round}</span><div class="min-w-0"><p class="sit-hist-p">${esc(h.card.p)}</p><p class="sit-hist-c">${esc([h.card.tag || THEMES[h.card.th], h.card.extra].filter(Boolean).join(' · '))} · ${esc(h.card.c)}</p></div></li>`).join('')
      : '<li class="sit-resting">Aucun round terminé.</li>';
    // Pas de repos assez long pour débriefer : le message passe sur l'écran de fin
    $('end-debrief').hidden = s.set.restSec >= DEBRIEF_MIN;
    const box = $('end-kot');
    box.hidden = !s.kot;
    if (!s.kot) { box.innerHTML = ''; return; }
    box.innerHTML = `
      ${s.snap ? `<p class="sit-label">Dernier round : qui a gagné ?</p><div class="sit-kot-btns sit-mb">
        <button type="button" class="sit-btn press" data-end="king" aria-pressed="${s.decision === 'king'}">Le roi garde sa place</button>
        <button type="button" class="sit-btn press" data-end="chal" aria-pressed="${s.decision === 'chal'}">Le challenger prend la place</button></div>` : ''}
      <div class="sit-streak"><p class="sit-label">Meilleure série de la séance</p><p class="sit-streak-n font-display">${s.kot.best}</p></div>`;
  }
  $('end-kot').addEventListener('click', e => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-end]');
    if (!b || !ses || !ses.snap) return;
    const which = b.dataset.end as 'king' | 'chal';
    if (ses.decision === which) return;
    ses.kot = clone(ses.snap);
    kotDecide(ses.kot, which === 'king');
    ses.decision = which;
    renderEnd();
  });

  function closeSession() {
    stopLoop();
    releaseScreen();
    ses = null;
    overlay.hidden = true;
    overlay.removeAttribute('data-wall');
    $('s-wall').setAttribute('aria-pressed', 'false');
    try { if (document.fullscreenElement) document.exitFullscreen().catch(() => {}); } catch { /* rien */ }
    document.documentElement.style.overflow = '';
    $('start-main').focus({ preventScroll: true });
  }
  $('relaunch').addEventListener('click', () => { stopLoop(); startSession(); });
  $('back').addEventListener('click', closeSession);
  document.querySelectorAll('.start-btn').forEach(b => b.addEventListener('click', startSession));

  // Barre du bas : seulement quand le bouton Démarrer sous la carte est hors de l'écran
  const startBar = $('start-bar');
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      const show = !entry.isIntersecting;
      startBar.classList.toggle('is-on', show);
      startBar.toggleAttribute('inert', !show);
    }).observe($('start-main'));
  } else {
    startBar.classList.add('is-on');
    startBar.removeAttribute('inert');
  }

  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState !== 'visible' || !ses || ses.phase === 'done') return;
    lockScreen();
    tick();
  });
  document.addEventListener('fullscreenchange', () => {
    if (!document.fullscreenElement && overlay.hasAttribute('data-wall')) {
      overlay.removeAttribute('data-wall');
      $('s-wall').setAttribute('aria-pressed', 'false');
    }
  });
</script>

<style is:global>
  /* Éléments générés en JS : les styles scopés d'Astro ne s'y appliquent pas */
