  }
  .sit-flash.is-on { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .sit-flash { transform: none; } }
  .sit-resting { margin-top: 10px; color: rgb(var(--c-muted)); }
  /* Repos en format « tout le monde » : consigne lisible depuis le tapis */
  .sit-partner {
