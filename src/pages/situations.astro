  /* Carte d'aperçu, en haut de page : plus compacte pour tenir sur un petit téléphone sans défiler.
     Planchers : nom de la position 28 px, objectifs 15 px. La carte de séance n'est pas concernée. */
  .sit-card-preview { padding: 16px; }
  @media (min-width: 640px) { .sit-card-preview { padding: 22px; } }
