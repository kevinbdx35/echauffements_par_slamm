  #session[data-wall] .sit-rule-text { font-size: 26px; }
  #session[data-wall] .sit-half-name { font-size: 40px; font-size: clamp(22px, 9cqi, 40px); }
  #session[data-wall] .sit-partner { font-size: clamp(48px, 12vw, 110px); }
