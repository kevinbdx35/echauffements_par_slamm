---
import Layout from '../layouts/Layout.astro';
import Programme from '../components/Programme.astro';
import exercices from '../data/mma.json';
import phases from '../data/mma-phases.json';

const principes = [
  { titre: 'Durée totale', texte: '18-20 minutes.' },
  { titre: 'Couvre les 3 phases du MMA', texte: 'Debout (striking), clinch (dirty boxing/lutte), sol (grappling) ET surtout les transitions entre chaque phase.' },
  { titre: 'Zéro mouvement décoratif', texte: 'Chaque drill reproduit une situation de combat réelle.' },
  { titre: 'Montée progressive', texte: 'Du solo au partenaire, du sol au debout.' },
  { titre: "Intègre l'attaque ET la défense", texte: 'Chaque phase contient des éléments offensifs et défensifs.' },
  { titre: "Le MMA n'est pas du kickboxing + du grappling", texte: "C'est la capacité à transitionner entre les phases." },
];
---

<Layout
  title="Échauffement MMA"
  description="Programme d'échauffement pour les séances MMA — arts martiaux mixtes"
>
  <Programme
    discipline="MMA"
    duree="18-20 min"
    exercices={exercices}
    phases={phases}
    principes={principes}
    conclusion="Un fighter MMA ne doit jamais être surpris par un changement de phase. Si tu drill les transitions chaque jour pendant l'échauffement, passer du striking au clinch au sol et inversement devient un réflexe, pas une réaction de panique."
    note="Cet échauffement pourra s'ajuster dans le temps si besoin."
  />
</Layout>
