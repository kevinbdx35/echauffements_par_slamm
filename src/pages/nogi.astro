---
import Layout from '../layouts/Layout.astro';
import Programme from '../components/Programme.astro';
import exercices from '../data/nogi.json';
import phases from '../data/nogi-phases.json';
import programmes from '../data/programmes.json';

const principes = [
  { titre: 'Durée totale', texte: `${programmes.nogi.duree}, tous les mardis.` },
  { titre: 'Zéro mouvement inutile', texte: 'Chaque drill est un pattern qui revient en combat réel.' },
  { titre: 'Montée progressive', texte: 'Du solo au partenaire, du lent au plus dynamique.' },
  { titre: "Répétable à l'infini", texte: "C'est un rituel, pas une surprise. Le corps apprend par la répétition." },
  { titre: 'Le cardio vient naturellement', texte: 'En enchaînant ces mouvements techniques avec fluidité, la fréquence cardiaque monte sans jamais faire de « gym ».' },
];
---

<Layout
  title="Échauffement NOGI"
  description="Échauffement rituel NOGI — applicable tous les mardis"
>
  <Programme
    discipline="NOGI"
    sousTitre="Tous les mardis · Dans l'ordre"
    accroche="Zéro mouvement inutile"
    duree={programmes.nogi.duree}
    exercices={exercices}
    phases={phases}
    principes={principes}
    conclusion="Chaque minute de l'échauffement rend meilleur en grappling. Pas de jumping jacks, pas de pompes punitives. Du mouvement spécifique, du drilling léger, de la construction de réflexes."
    note="Cet échauffement rituel pourra s'ajuster dans le temps si besoin."
  />
</Layout>
