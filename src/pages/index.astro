---
import Layout from '../layouts/Layout.astro';
import mma from '../data/mma.json';
import nogi from '../data/nogi.json';
const base = import.meta.env.BASE_URL;

const programmes = [
  { href: `${base}mma`, titre: 'MMA', sousTitre: 'Arts martiaux mixtes', meta: `18-20 min · ${mma.length} exercices` },
  { href: `${base}nogi`, titre: 'NOGI', sousTitre: 'Grappling sans kimono', meta: `18-20 min · ${nogi.length} exercices` },
  { href: `${base}etirements`, titre: 'Étirements', sousTitre: 'Fin de séance', meta: '15 min · 22 pages', large: true },
];
---

<Layout title="Échauffements — NOGI & MMA">
  <div class="text-center py-8 sm:py-16">
    <h1 class="text-3xl sm:text-5xl font-black tracking-tight mb-3 sm:mb-4">
      <span class="text-accent-500">Échauffements</span><br />
      MMA & NOGI
    </h1>
    <p class="text-gray-400 text-base sm:text-lg max-w-sm mx-auto mb-8 sm:mb-12 px-2">
      Programme structuré avant chaque séance. Suis les exercices dans l'ordre.
    </p>

    <div class="grid grid-cols-1 gap-4 max-w-sm mx-auto sm:grid-cols-2 sm:max-w-xl">
      {programmes.map(p => (
        <a
          href={p.href}
          class:list={[
            "group flex items-center gap-4 bg-gray-800 border border-gray-700 rounded-xl p-5 text-left transition-[background-color,border-color,transform] duration-150 ease-out hover:border-gray-600 active:bg-gray-700 motion-safe:active:scale-[0.98]",
            p.large && "sm:col-span-2",
          ]}
        >
          <div class="flex-1 min-w-0">
            <h2 class="text-xl font-black text-white">{p.titre}</h2>
            <p class="text-gray-300 text-sm leading-snug">{p.sousTitre}</p>
            <p class="text-gray-400 text-xs mt-1">{p.meta}</p>
          </div>
          <span class="text-accent-400 text-lg shrink-0 transition-transform duration-150 ease-out motion-safe:group-hover:translate-x-0.5" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>
</Layout>
