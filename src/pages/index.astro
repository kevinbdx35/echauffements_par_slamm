---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import mma from '../data/mma.json';
import nogi from '../data/nogi.json';
import etirements from '../data/etirements.json';
import durees from '../data/programmes.json';
const base = import.meta.env.BASE_URL;

const programmes = [
  { href: `${base}mma`, titre: 'MMA', sousTitre: 'Arts martiaux mixtes', meta: `${durees.mma.duree} · ${mma.length} exercices` },
  { href: `${base}nogi`, titre: 'NOGI', sousTitre: 'Grappling sans kimono', meta: `${durees.nogi.duree} · ${nogi.length} exercices` },
];
const apres = { href: `${base}etirements`, titre: 'Étirements', sousTitre: 'Fin de séance, tout le corps', meta: `${durees.etirements.duree} · ${etirements.length} pages` };
---

<Layout title="Échauffements — NOGI & MMA">
  <div class="max-w-site mx-auto px-4 md:px-8 py-10 lg:py-24 grid gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16 lg:items-start">
    <div>
      <h1 class="font-display text-[clamp(44px,13.5vw,104px)] lg:text-[clamp(64px,6.2vw,92px)]">
        <span class="block text-accent">Échauffements</span>
        MMA &amp; NOGI
      </h1>
      <p class="mt-5 text-lg text-muted max-w-[32ch]">
        Programme structuré avant chaque séance. Suis les exercices dans l'ordre.
      </p>
    </div>

    <div class="flex flex-col">
      {programmes.map(p => (
        <a href={p.href} class="prog">
          <span class="prog-title font-display">{p.titre}</span>
          <span class="text-muted">{p.sousTitre}</span>
          <span class="text-sm font-semibold tabular-nums">{p.meta}</span>
          <span class="prog-arrow"><Icon name="arrow-right" /></span>
        </a>
      ))}
      <p class="mt-8 pb-2.5 text-xs font-bold uppercase tracking-[0.12em] text-muted">Après la séance</p>
      <a href={apres.href} class="prog border-b border-line">
        <span class="prog-title font-display">{apres.titre}</span>
        <span class="text-muted">{apres.sousTitre}</span>
        <span class="text-sm font-semibold tabular-nums">{apres.meta}</span>
        <span class="prog-arrow"><Icon name="arrow-right" /></span>
      </a>
    </div>
  </div>
</Layout>

<style>
  .prog {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 4px 16px;
    padding-block: 24px;
    border-top: 1px solid rgb(var(--c-line));
  }
  .prog > :not(.prog-arrow) { grid-column: 1; }
  .prog-title {
    font-size: clamp(40px, 9vw, 64px);
    transition: color 150ms ease;
  }
  .prog-arrow {
    grid-column: 2;
    grid-row: 1 / span 3;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    border: 1px solid rgb(var(--c-line));
    transition-property: transform, color, background-color, border-color;
    transition-duration: 150ms;
    transition-timing-function: cubic-bezier(0.23, 1, 0.32, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    .prog:hover .prog-title { color: rgb(var(--c-accent)); }
    .prog:hover .prog-arrow {
      background: rgb(var(--c-accent-strong));
      border-color: rgb(var(--c-accent-strong));
      color: #fff;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .prog:active .prog-arrow { transform: scale(0.94); }
    @media (hover: hover) and (pointer: fine) {
      .prog:hover .prog-arrow { transform: translateX(2px); }
      .prog:active .prog-arrow { transform: translateX(2px) scale(0.94); }
    }
  }
</style>
