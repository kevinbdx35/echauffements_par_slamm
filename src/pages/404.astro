---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Page introuvable — Échauffements par SLAMM" description="Cette page n'existe pas.">
  <div class="max-w-site mx-auto px-4 md:px-8 py-16 lg:py-28">
    <p class="font-display text-[clamp(120px,24vw,240px)] leading-[0.8] text-accent tabular-nums" aria-hidden="true">404</p>
    <h1 class="mt-6 font-display text-[clamp(36px,7vw,64px)]">Page introuvable</h1>
    <p class="mt-3 text-lg text-muted max-w-[40ch]">Cette page n'existe pas ou a été déplacée.</p>
    <a href={base} class="cta press mt-8 inline-flex items-center gap-2 min-h-12 px-6 rounded-full bg-accent-strong text-white font-semibold hover:bg-accent-strong/90">
      Retour à l'accueil <Icon name="arrow-right" class="size-4" />
    </a>
  </div>
</Layout>
