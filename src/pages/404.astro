---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Page introuvable — Échauffements par SLAMM" description="Cette page n'existe pas.">
  <div class="text-center py-20">
    <p class="text-6xl font-black text-accent-500 mb-4">404</p>
    <h1 class="text-2xl font-bold text-white mb-2">Page introuvable</h1>
    <p class="text-gray-400 mb-8">Cette page n'existe pas ou a été déplacée.</p>
    <a href={base} class="inline-block bg-accent-600 hover:bg-accent-700 text-white font-semibold px-6 py-3 rounded-full transition-[background-color,transform] duration-150 ease-out motion-safe:active:scale-[0.97]">
      Retour à l'accueil
    </a>
  </div>
</Layout>
